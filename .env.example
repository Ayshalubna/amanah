# LLM backend: ollama (free, local) | openai (any OpenAI-compatible API, e.g. Groq free tier) | none
AMANAH_LLM=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# For AMANAH_LLM=openai (Groq free tier shown; works with Azure OpenAI / OpenAI too)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=

# Retrieval: auto uses multilingual embeddings if sentence-transformers is installed; off = TF-IDF only
AMANAH_EMBEDDINGS=auto
